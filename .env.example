# Copy to .env.local and fill in. Never commit .env.local.

# Naive (required)
NAIVE_API_KEY=sk_live_...
NAIVE_BASE_URL=https://api.vetta.sh
NAIVE_WEBHOOK_SECRET=            # returned when the session.idle webhook is created (scripts/30-naive-setup.ts)
NAIVE_MODEL=                     # pick from `naive models list` or scripts/00-smoke.ts output
NAIVE_ENVOY_AGENT_ID=
NAIVE_HEAD_AGENT_ID=

# Our MCP server (Naive -> Vercel). Any long random string; stored in the Naive vault as static_bearer.
MCP_SHARED_SECRET=change-me-to-a-long-random-string
PUBLIC_BASE_URL=https://<your-vercel-app>.vercel.app

# Mobilerun
MOBILERUN_CLOUD_API_KEY=dr_sk_...
MOBILERUN_ANDROID_DEVICE_ID=     # cloud Android running the Alibaba.com app
MOBILERUN_IPHONE_DEVICE_ID=      # your tethered iPhone (Personal Phone) running WeChat

# Apify
APIFY_TOKEN=

# AgentMail
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=              # e.g. sourcing@<your-domain>.agentmail.to
AGENTMAIL_WEBHOOK_SECRET=

# LLMs (called directly; Naive's proxy rejects images/strict JSON). OpenRouter is the only required one.
OPENROUTER_API_KEY=
OPENROUTER_ZH_MODEL=qwen/qwen3.8-flash          # Chinese drafting/translation (vision-capable)
OPENROUTER_STRONG_MODEL=openai/gpt-5.6-luna     # screenshot/quote parsing
OPENROUTER_MEMO_MODEL=openai/gpt-5.6-sol        # decision memo
OPENAI_API_KEY=                                 # OPTIONAL: if set, memo/vision go to OpenAI directly
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_MEMO_MODEL=gpt-5.6-sol

# Neon (Vercel Marketplace injects DATABASE_URL)
DATABASE_URL=postgres://...

# Demo company
COMPANY_NAME=Sentinel Care
FOUNDER_EMAIL=
FOUNDER_NAME=Matthew

# Guard for /ops and /api/approve when public (any random string)
DASHBOARD_TOKEN=

# WeChat channel: "mac" = WeChat desktop on this Mac (AppleScript + screenshots); otherwise the Mobilerun iPhone
WECHAT_MODE=mac

# Alibaba channel: "app" = official Alibaba.com app on the cloud Android; anything else = mobile web in Chrome
ALIBABA_MODE=app
ALIBABA_VISION=1
